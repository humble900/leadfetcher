# ─── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadfetcher

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Super Admin (created on seed) ────────────────────────────
SUPER_ADMIN_EMAIL=admin@leadfetcher.com
SUPER_ADMIN_PASSWORD=changeme123!

# ─── LLM (optional — only needed for Pro/Enterprise) ─────────
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# ─── Proxy Rotation (optional — for high-volume scraping) ────
# Mode: "open_source" (free proxies), "hybrid" (free + paid), or unset (paid only)
# PROXY_MODE=open_source

# Single paid proxy (BrightData, Oxylabs, SmartProxy, etc.)
# PROXY_URL=http://username:password@proxy.brightdata.com:22225

# Multiple proxies (comma-separated)
# PROXY_URLS=http://proxy1:8080,http://proxy2:8080,socks5://proxy3:1080

# ─── Worker Scaling ──────────────────────────────────────────
# WORKER_CONCURRENCY=2
